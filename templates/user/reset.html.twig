{% extends 'user/signin.html.twig' %}

{% block tochange %}
        <div class="request-login-container">
                <div class="request-login-card">
                   
                    <div class="request-form-container">
                        <div class="close-btn ">
                            <a href="{{ path('app_home') }}"><span class="material-symbols-outlined">close</span></a> 
                        </div>
                    
                        <div class="form-title">
                            <h1>Reset you password <span class="material-symbols-outlined">lock_open</span></h1>
                        </div> 
                        
                        {{ form_start(form, {'attr': {'class': 'action-form','novalidate': 'novalidate' }}) }}

                            <div class="action-form-row">
                                {{ form_label(form.password) }}
                                {{ form_widget(form.password) }} 
                                <div class="action-form-erro">
                                    {{ form_errors(form.password) }}
                                </div>
                            </div>
                        
                         <div class="action-form-row">
                                {{ form_label(form.confirmpassword) }}
                                {{ form_widget(form.confirmpassword) }} 
                                <div class="action-form-erro">
                                    {{ form_errors(form.confirmpassword) }}
                                </div>
                            </div>
                            
                            {{ form_row(form.save, {'attr': {'class': 'action-button'}} ) }}
                        {{ form_end(form) }}
                     
                </div>
            </div>
        </div>    
{% endblock %}